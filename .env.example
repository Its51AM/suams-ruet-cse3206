# Copy this file to .env and replace with secure values in your local environment.
APP_NAME="Smart University Academic Management System (SUAMS)"
ENVIRONMENT=development
SECRET_KEY=replace-this-with-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./suams.db
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=noreply@suams.ruet.ac.bd
COOKIE_SECURE=false
